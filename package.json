{
  "name": "gatsby-s3-action",
  "version": "0.0.0",
  "private": true,
  "description": "Deploy a Gatsby Project to an AWS S3 bucket (optional Cloudfront support)",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p __tests__ && tsc -p tsconfig.tooling.json",
    "format": "prettier --write \"**/*.{ts,mts,mjs}\"",
    "format-check": "prettier --check \"**/*.{ts,mts,mjs}\"",
    "lint": "eslint",
    "test": "node --experimental-test-module-mocks --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "check": "npm run typecheck && npm run format-check && npm run lint && npm test",
    "bundle": "ncc build src/main.ts",
    "all": "npm run check && npm run bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonelantha/gatsby-s3-action.git"
  },
  "keywords": [
    "deploy",
    "gatsby",
    "aws",
    "s3",
    "cloudfront",
    "action"
  ],
  "author": "jonelantha",
  "license": "MIT",
  "engines": {
    "node": "^26"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
