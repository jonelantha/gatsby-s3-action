{
  "name": "gatsby-s3-action",
  "version": "0.0.0",
  "private": true,
  "description": "Deploy a Gatsby Project to an AWS S3 bucket (optional Cloudfront support)",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p __tests__",
    "format": "prettier --write \"**/*.{ts,mts,mjs}\"",
    "format-check": "prettier --check \"**/*.{ts,mts,mjs}\"",
    "lint": "eslint",
    "pack": "ncc build src/main.ts",
    "test": "node --experimental-test-module-mocks --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "all": "npm run build && npm run format && npm run lint && npm run pack && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonelantha/gatsby-s3-action.git"
  },
  "keywords": [
    "deploy",
    "gatsby",
    "aws",
    "s3",
    "cloudfront",
    "action"
  ],
  "author": "jonelantha",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.38.0",
    "eslint-plugin-github": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
