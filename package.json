{
  "name": "gatsby-s3-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deploy a Gatsby Project to an AWS S3 bucket (optional Cloudfront support)",
  "scripts": {
    "typecheck": "tsc",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "format-check": "prettier --check \"**/*.{ts,js}\"",
    "lint": "eslint",
    "test": "node --experimental-test-module-mocks --test",
    "check": "npm run typecheck && npm run format-check && npm run lint && npm test",
    "bundle": "ncc build -C src/main.ts",
    "all": "npm run check && npm run bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonelantha/gatsby-s3-action.git"
  },
  "author": "jonelantha",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
